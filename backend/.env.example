NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
TRUST_PROXY=false
RATE_LIMIT_MAX=60
AI_RATE_LIMIT_MAX=10
AI_PROVIDER=disabled
# Recommended hosted provider. Change AI_PROVIDER to gemini and put the secret only in backend/.env.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_API_KEY=replace-with-your-google-ai-studio-key
GEMINI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_MS=60000

# Optional fallback for Ollama or another OpenAI-compatible provider.
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_API_KEY=ollama
AI_MODEL=qwen3:4b-instruct

# Embedded mode uses an in-memory PostgreSQL-compatible database, migrates it, and loads the curated seed at startup.
# Production must use DATABASE_MODE=postgres and provide DATABASE_URL.
DATABASE_MODE=embedded
# DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:5432/postgres
DATABASE_SSL_MODE=require
DATABASE_POOL_MAX=10

# Local development identity. Production must use AUTH_MODE=jwks.
AUTH_MODE=development
AUTH_DEV_USER_ID=00000000-0000-4000-8000-000000000001
AUTH_DEV_EMAIL=careermate@gmail.com
AUTH_DEV_PASSWORD=12345
AUTH_JWKS_URL=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
AUTH_JWT_ISSUER=https://PROJECT_REF.supabase.co/auth/v1
AUTH_JWT_AUDIENCE=authenticated
# Public Supabase project values used only by the backend auth gateway. Never use a service-role key here.
AUTH_SUPABASE_URL=https://PROJECT_REF.supabase.co
AUTH_SUPABASE_ANON_KEY=your-public-anon-key
