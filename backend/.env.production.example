NODE_ENV=production
HOST=0.0.0.0
PORT=3000
CORS_ORIGINS=https://your-frontend.example.com
TRUST_PROXY=true
RATE_LIMIT_MAX=60
AI_RATE_LIMIT_MAX=10

AI_PROVIDER=gemini
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=replace-with-a-new-production-key
GEMINI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_MS=60000

DATABASE_MODE=postgres
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres
DATABASE_SSL_MODE=require
DATABASE_POOL_MAX=10

AUTH_MODE=jwks
AUTH_JWKS_URL=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
AUTH_JWT_ISSUER=https://PROJECT_REF.supabase.co/auth/v1
AUTH_JWT_AUDIENCE=authenticated
AUTH_SUPABASE_URL=https://PROJECT_REF.supabase.co
AUTH_SUPABASE_ANON_KEY=replace-with-public-anon-or-publishable-key
