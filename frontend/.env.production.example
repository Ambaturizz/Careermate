# Include /api/v1. This value is embedded into the production JavaScript bundle at build time.
# Frontend-only portfolio/demo deployment. No backend or AI key is required.
VITE_DEMO_MODE=true

# Set VITE_DEMO_MODE=false when a real backend is available, then configure:
VITE_API_URL=https://your-backend.example.com/api/v1
VITE_API_TIMEOUT_MS=90000
